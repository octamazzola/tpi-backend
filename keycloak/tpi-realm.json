      "emailVerified": true,
      "firstName": "Turista",
      "lastName": "Uno",
      "credentials": [{ "type": "password", "value": "1234", "temporary": false }],
      "realmRoles": ["TURISTA"]
    },
    {
      "username": "turista2",
