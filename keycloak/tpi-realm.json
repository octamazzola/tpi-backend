{
  "realm": "tpi-realm",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "TURISTA", "description": "Cliente final: explora el catálogo y gestiona sus propias reservas" },
      { "name": "OPERADOR", "description": "Prestador turístico: publica actividades y confirma reservas" },
      { "name": "ADMIN", "description": "Administrador de la plataforma: acceso total" }
    ]
  },
  "clients": [
    {
      "clientId": "tpi-client",
      "name": "TPI Backend (Postman / Frontend)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "turista1",
      "enabled": true,
