# Carpeta de documentación local (no versionada)
gitignore/

# Ignorar archivos Markdown excepto el README.md principal
*.md
**/*.md
!README.md

# Maven - archivos de compilación y empaquetado
target/
**/target/
*.class

# IDEs y Editores
.idea/
*.iml
*.iws
.vscode/
*.ipr
.settings/
.project
.classpath

# Logs y temporales
*.log
*.tmp
*.bak

# Datos de mapas pesados de OSRM (pesan +4 GB y GitHub solo permite archivos <100MB)
osrm-data/
osrm-data.zip
*.osm.pbf

# Zip de entrega generado localmente
tpi-backend-entrega.zip
